# Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://pulsars:pulsars@localhost:5433/pulsars
PORT=3000
PULSARS_HOST=127.0.0.1

# MQTT broker (Mosquitto from docker-compose.yml). Unset to run without the subscriber.
MQTT_URL=mqtt://localhost:1883
# MQTT_CLIENT_ID=pulsars-backend

# Local LLM, OpenAI-compatible API. These are the defaults (Ollama).
# LLM_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_TIMEOUT_MS=60000

# Signing key for login tokens: required, at least 32 characters, keep it secret.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
# JWT_TTL_HOURS=12
