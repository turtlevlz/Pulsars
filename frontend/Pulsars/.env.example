# Which patient the dashboard acts as. There is no login yet, so this is fixed.
# 2 is "Alice" from the backend seed (backend: npm run db:seed).
VITE_USER_ID=2

# Where the API lives. "/api" is forwarded to the backend by the Vite dev server
# (see vite.config.ts). Set a full URL (and enable CORS on the backend) to bypass that.
VITE_API_URL=/api
